# ============================================================
# .env — Configurações do LinkDim WebCrawler C++
# Copie este arquivo para a raiz do projeto e preencha.
# NUNCA commite este arquivo com dados reais!
# ============================================================

# ── Credenciais LinkedIn (obrigatório) ──────────────────────
LINKEDIN_USERNAME=seu@email.com
LINKEDIN_PASSWORD=suasenha

# ── Conexão PostgreSQL (obrigatório se DATABASE_ENABLED) ────
# Formato Render.com: postgresql://user:pass@host:5432/dbname
WEBCRAWLER_DB_CONNECTION=postgresql://usuario:senha@host:5432/banco

# ── Comportamento do Crawler ─────────────────────────────────
WEBCRAWLER_TEST_MODE=false
WEBCRAWLER_DISABLE_DATABASE=false
WEBCRAWLER_MAX_PAGES_PER_CYCLE=0
WEBCRAWLER_MAX_APPLY_PER_CYCLE=15
WEBCRAWLER_CYCLE_WAIT_MINUTES=45
WEBCRAWLER_USE_PERSISTENT_PROFILE=true
WEBCRAWLER_PERSIST_IGNORED_LINKS=true
WEBCRAWLER_PERSIST_SUCCESSFUL_LINKS=true
WEBCRAWLER_AUTO_FILL_MANDATORY_FIELDS=true

# ── Delays de Humanização (ms) ───────────────────────────────
WEBCRAWLER_INTERACTION_DELAY_MIN_MS=800
WEBCRAWLER_INTERACTION_DELAY_MAX_MS=2500
WEBCRAWLER_APPLY_DELAY_MIN_MS=5000
WEBCRAWLER_APPLY_DELAY_MAX_MS=15000
WEBCRAWLER_PAGINATION_DELAY_MIN_MS=1200
WEBCRAWLER_PAGINATION_DELAY_MAX_MS=2800

# ── Janela de Horário Ativo (opcional) ───────────────────────
# Exemplo: só roda entre 8h e 22h
# WEBCRAWLER_ACTIVE_HOURS_START=8
# WEBCRAWLER_ACTIVE_HOURS_END=22

# ── Busca de Vagas ───────────────────────────────────────────
WEBCRAWLER_USE_JOBS_SEARCH_ENTRY=true
# WEBCRAWLER_JOB_SEARCH_TERMS=C#,Python,Qt,PostgreSQL

# ── AutoFill de Formulários ──────────────────────────────────
WEBCRAWLER_DEFAULT_FIRST_NAME=Clovis
WEBCRAWLER_DEFAULT_LAST_NAME=Silva
WEBCRAWLER_DEFAULT_PHONE=11959391726
WEBCRAWLER_DEFAULT_LOCATION=Sao Paulo
WEBCRAWLER_DEFAULT_EMAIL=clovis.eduardosilva23@gmail.com
WEBCRAWLER_DEFAULT_LINKEDIN_URL=www.linkedin.com/in/clovis-silva-dev
WEBCRAWLER_DEFAULT_SALARY=7500
WEBCRAWLER_DEFAULT_YEARS_EXPERIENCE=10
WEBCRAWLER_DEFAULT_GENERIC_TEXT=Tenho experiencia compativel com a vaga e disponibilidade para atuar no escopo solicitado.
WEBCRAWLER_DEFAULT_CHECKBOX_TRUE=true
WEBCRAWLER_DEFAULT_WORK_AUTHORIZATION=true
WEBCRAWLER_DEFAULT_NEED_VISA_SPONSORSHIP=false
