# ── CREDENCIAIS DO LINKEDIN ──────────────────────────────────
LINKEDIN_USERNAME=seu_email@exemplo.com
LINKEDIN_PASSWORD=sua_senha_aqui

# ── BANCOS DE DADOS ──────────────────────────────────────────
WEBCRAWLER_DB_PROVIDER=dual
WEBCRAWLER_DB_CONNECTION=Host=127.0.0.1;Port=5432;Database=ProjetoDb;Username=postgres;Password=sua_senha_pg
WEBCRAWLER_MYSQL_CONNECTION=Server=seu_host_mysql;Port=3306;Database=seu_banco;User ID=seu_usuario;Password=sua_senha_mysql;SslMode=Preferred;AllowUserVariables=true;
WEBCRAWLER_DISABLE_DATABASE=false

# ── PARÂMETROS DE CICLO E NAVEGADOR ──────────────────────────
WEBCRAWLER_TEST_MODE=false
WEBCRAWLER_MAX_PAGES_PER_CYCLE=8
WEBCRAWLER_MAX_APPLY_PER_CYCLE=25
WEBCRAWLER_CYCLE_WAIT_MINUTES=40
WEBCRAWLER_USE_PERSISTENT_PROFILE=true

# ── AUTO-PREENCHIMENTO DE CANDIDATURAS ───────────────────────
WEBCRAWLER_AUTO_FILL_MANDATORY_FIELDS=true
WEBCRAWLER_DEFAULT_FIRST_NAME=SeuNome
WEBCRAWLER_DEFAULT_LAST_NAME=SeuSobrenome
WEBCRAWLER_DEFAULT_EMAIL=seu_email@exemplo.com
WEBCRAWLER_DEFAULT_PHONE=11999999999
WEBCRAWLER_DEFAULT_LOCATION=São Paulo
WEBCRAWLER_DEFAULT_CITY=São Paulo
WEBCRAWLER_DEFAULT_STATE=São Paulo
WEBCRAWLER_DEFAULT_ADDRESS=Seu Endereco
WEBCRAWLER_DEFAULT_ZIP=01000-000
WEBCRAWLER_DEFAULT_YEARS_EXPERIENCE=5
WEBCRAWLER_DEFAULT_SALARY=8000
WEBCRAWLER_DEFAULT_CHECKBOX_TRUE=true
WEBCRAWLER_DEFAULT_WORK_AUTHORIZATION=true
WEBCRAWLER_DEFAULT_NEED_VISA_SPONSORSHIP=false
WEBCRAWLER_DEFAULT_WEBSITE=https://github.com/seu_usuario
WEBCRAWLER_DEFAULT_LINKEDIN_URL=https://www.linkedin.com/in/seu_perfil
WEBCRAWLER_DEFAULT_GITHUB_URL=https://github.com/seu_usuario
WEBCRAWLER_DEFAULT_EDUCATION=Sua Instituicao - Seu Curso
WEBCRAWLER_DEFAULT_DEGREE=Superior completo
WEBCRAWLER_DEFAULT_JOB_TITLE=Desenvolvedor Full Stack
WEBCRAWLER_DEFAULT_CURRENT_COMPANY=Empresa Atual
WEBCRAWLER_DEFAULT_GENERIC_TEXT=Tenho experiencia compativel com a vaga e disponibilidade para atuar no escopo solicitado.
